  choose c _ hc using fun i => he i α j
  refine ⟨∑ i, b i * c i, trivial, ?_⟩

  simp only [comb, map_sum, coeff_smul, Finset.mul_sum, map_mul]
  refine Finset.sum_congr rfl fun i _ => ?_
