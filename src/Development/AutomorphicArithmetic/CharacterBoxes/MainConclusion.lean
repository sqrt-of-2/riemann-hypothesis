      UpperTheory.Cb.exists_finite_etale_restrict_clopen Y Z c1 (V j) (W j k) (hWcl j k) inf_le_left
        inferInstance inferInstance
    have ex2
        : ∀ j k, ∃ c' : (W j k).toScheme ⟶ (V k).toScheme,
          c' ≫ (V k).ι = (W j k).ι ≫ c2 ∧ IsFinite c' ∧ Etale c' := fun j k =>
      UpperTheory.Cb.exists_finite_etale_restrict_clopen Y Z c2 (V k) (W j k) (hWcl j k)
        inf_le_right f2 t2
    choose c1' e1 f1 t1 using ex1
    choose c2' e2 f2' t2' using ex2
    have g1 : ∀ j k, c1' j k ≫ (V j).ι ≫ s = (W j k).ι ≫ s' := by
      intro j k
      rw [← Category.assoc, e1, Category.assoc, h1]
    have g2 : ∀ j k, c2' j k ≫ (V k).ι ≫ s = (W j k).ι ≫ s' := by
      intro j k
      rw [← Category.assoc, e2, Category.assoc, h2]
    have hblock
        : ∀ j,
          (∀ b, FiniteDimensional ℂ (hodgeH ((V j).ι ≫ s) a b))
            ∧ ∑ b ∈ Finset.range (d + 1), (-1 : ℂ) ^ b * LinearMap.trace ℂ _
                (hodgeTrace (g1 j j) a b ∘ₗ hodgePull (g2 j j) a b)
              = ∑ y ∈ F with y ∈ Set.range (UpperTheory.Core.ptIn (s' := s') (W j j)),
                  (Matrix.det (1 + (Polynomial.X : Polynomial ℂ) • (A y).map Polynomial.C)).coeff a /
                    (1 - A y).det := by
      intro j
      have := hVi j
      have := f1 j j
      have := t1 j j
      exact UpperTheory.Core.block_fixed h1 h2 d hproj (V j) (hVcl j) (W j j) (c1' j j) (c2' j j)
        (e1 j j) (e2 j j) (f2' j j) (t2' j j) (g1 j j) (g2 j j) F hF A hA a
    have hglue
        : ∀ b,
          FiniteDimensional ℂ (hodgeH s a b)
            ∧ LinearMap.trace ℂ _ (hodgeTrace h1 a b ∘ₗ hodgePull h2 a b)
              = ∑ j, LinearMap.trace ℂ _ (hodgeTrace (g1 j j) a b ∘ₗ hodgePull (g2 j j) a b) := by
      intro b
      have : ∀ j, FiniteDimensional ℂ (hodgeH ((V j).ι ≫ s) a b) := fun j => (hblock j).1 b
      refine UpperTheory.Core.glue_trace
        (fun j => hodgePull (f := (V j).ι) (s' := (V j).ι ≫ s) rfl a b)
        (UpperTheory.Core.pull_bij s V hVd hVc a b) _
        (fun j k => hodgeTrace (g1 j k) a b ∘ₗ hodgePull (g2 j k) a b)
        ?_
      intro j x
      have := f1 j
      exact UpperTheory.Core.key_id h1 h2 V W j (hWd j) (hWr j) (c1' j) (c2' j) (e1 j) (e2 j) (f1 j)
        (t1 j) (g1 j) (g2 j) a b x
    refine ⟨fun b => (hglue b).1, ?_⟩
    exact UpperTheory.Core.final_sum (Finset.range (d + 1)) _ _
      (fun b => (hglue b).2)
      F
      (fun j => Set.range (UpperTheory.Core.ptIn (s' := s') (W j j)))
      (fun y hy => UpperTheory.Core.fixed_part V hVd' W hWm hWd2 hWc y ((hF y).1 hy))
      _
      (fun j => (hblock j).2)
end -- clump:auto
