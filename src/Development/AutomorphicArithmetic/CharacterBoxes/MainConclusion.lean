private theorem pull_bij
    {Z : Scheme.{0}} (s : Z ⟶ Sp ℂ)
    {J : Type} (V : J → Z.Opens) (hdis : ∀ i j, i ≠ j → V i ⊓ V j = ⊥) (hcov : iSup V = ⊤)
    (a b : ℕ)
