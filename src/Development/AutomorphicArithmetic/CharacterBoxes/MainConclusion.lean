      (fun j => e j (cohOn.res ℤ (Omega s a) (le_top : V j ≤ ⊤) b x)
        : ∀ j, hodgeH ((V j).ι ≫ s) a b)) :=
    (Equiv.piCongrRight e).bijective.comp hres
