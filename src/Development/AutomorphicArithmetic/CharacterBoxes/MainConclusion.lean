    (c1 c2 : Y ⟶ Z') (a1 a2 : Y ⟶ Z) (e1 : c1 ≫ e = a1) (e2 : c2 ≫ e = a2)
    (h1 : c1 ≫ e ≫ s = s') (h2 : c2 ≫ e ≫ s = s')
