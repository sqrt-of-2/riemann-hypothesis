private theorem preimage_disjoint
    {Y : Scheme.{0}} (T : Y.Opens)
    {M : Type} (W : M → Y.Opens) (hd : ∀ i j, i ≠ j → W i ⊓ W j = ⊥) (i j : M) (hij : i ≠ j)
